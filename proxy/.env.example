# Copy to .env for the local dev stack: cp .env.example .env
#
# Only the values compose does not already set live here. Everything about the
# local topology — Keycloak URLs, client secret, session secret, origins — is
# in compose.yaml, because changing it breaks the stack rather than adapting
# it.
#
# .env is gitignored. Never commit a real token.

# A fine-grained personal access token on a bot account, scoped to the one
# repository below, with Contents and Pull requests write access.
# Create at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_replace_me

# The one repository this proxy may write to. Owner and repo are substituted
# into every forwarded GitHub path, which is how the pinning works, so they
# must be plain path segments. Keep them in sync with `repo:` in
# dev/admin/config.yml.
GITHUB_OWNER=prodeko
GITHUB_REPO=prodeko-org

# No default on purpose. Local testing writes real commits and opens real pull
# requests against this branch, so it has to be a throwaway you created for the
# purpose. Copying a file that already said main is how a test run ends up in
# the history of the live branch.
GITHUB_BRANCH=

# Optional. Defaults to https://api.github.com.
# GITHUB_API_ROOT=https://api.github.com

# Optional. The git *committer* stamped on every commit — the machine that
# carried it. The *author* is always the signed-in editor's verified Keycloak
# name and email and is not configurable. Defaults to
# "Prodeko CMS <cms@prodeko.org>"; set these to the bot account's own name and
# address if you want GitHub to link the committer to that account.
# GITHUB_COMMITTER_NAME=Prodeko CMS
# GITHUB_COMMITTER_EMAIL=cms@prodeko.org


# ---------------------------------------------------------------------------
# For reference: the full variable set, as a production deployment sets it.
# The dev stack gets these from compose.yaml instead.
# ---------------------------------------------------------------------------
#
# Required:
#   PUBLIC_URL=https://cms.prodeko.org
#       Where this service is reachable. A bare origin — scheme://host[:port],
#       no path, no trailing slash. Decap compares the login popup's
#       postMessage event origin against this value character for character,
#       and an event origin never has a path. Get it wrong and login hangs
#       with nothing in the console.
#
#   CMS_ORIGINS=https://prodeko.org,https://www.prodeko.org
#       Every origin the editing screen is served from. Decap's calls to
#       api_root come from the browser, cross-origin, so these need CORS
#       headers. Comma-separated bare origins; "*" is refused.
#
#   KEYCLOAK_ISSUER=https://id.prodeko.org/realms/membership-registry
#       Exactly the `iss` claim Keycloak puts in its tokens.
#
#   KEYCLOAK_CLIENT_ID=cms-auth-proxy
#   KEYCLOAK_CLIENT_SECRET=...
#       A confidential client, standard flow only, PKCE S256, with
#       PUBLIC_URL + /callback as an exact redirect URI. Registered by hand in
#       the admin console per membership-registry/docs/keycloak-clients.md.
#       That client needs a "User Realm Role" protocol mapper, multivalued,
#       claim name realm_access.roles, added to the ID token. The built-in
#       roles scope only puts it in the access token; without the mapper every
#       editor is denied.
#
#   EDITOR_ROLES=membership,prodeko-org-admin
#       The realm roles required to edit, comma-separated. An editor must hold
#       every one of them, and at least one has to be listed or the proxy
#       refuses to start. membership is maintained by the membership registry
#       and lapses on its own when someone stops being a guild member;
#       prodeko-org-admin is granted by hand. Requiring both means the
#       hand-granted half stops working the moment the automatic half lapses,
#       rather than waiting for somebody to remember to revoke it.
#
#   GITHUB_TOKEN, GITHUB_OWNER, GITHUB_REPO, GITHUB_BRANCH
#
#   SESSION_SECRET=...
#       At least 32 bytes: openssl rand -base64 48
#
# Optional:
#   LISTEN_ADDR=:8080
#   LOG_LEVEL=info                debug | info | warn | error
#   SESSION_TTL=8h
#   OAUTH_SCOPE=openid profile email
#   GITHUB_API_ROOT=https://api.github.com
#   GITHUB_COMMITTER_NAME, GITHUB_COMMITTER_EMAIL
#   KEYCLOAK_DISCOVERY_URL=...
#       Only for split-horizon setups such as the dev compose stack, where the
#       browser and the proxy reach Keycloak at different addresses. Discovery
#       happens here; `iss` is still validated against KEYCLOAK_ISSUER.
